\paperw12240\paperh15840\margl850\margr850\margt700\margb700\gutter0 \ftnbj\hyphhotz425 \sectd \linex0\headery709\footery709\colsx709 \pard\plain \qc \f2\fs24\lang1034 {\plain \f2\fs28\b\lang1034 ANEXO DE CALCULOS}{\plain \b\f2\lang1034
\par }\pard \qc 
\par
\par \pard {\b F}{\b \'f3}{\b rmulas Generales}{\b
\par }{\ul
\par }\fs18 Emplearemos las siguientes:
\par \pard
\par \pard {\ul Tuber\'edas y v\'e1lvulas}.
\par \par \pard \li567  Pa\'b2 - Pb\'b2 = 48,6 x dc x L x Q{\fs12 \up6 1,82} x D{\fs12 \up6 -4,82}        (1)
\par \par \pard y para presiones relativas inferiores o iguales a 500 mmca 
 \par \par \pard \li567  Pa - Pb = 232000 x dc x L x Q{\fs12 \up6 1,82} x D{\fs12 \up6 -4,82}        (2)
\par \par v = (360,86 x Q) / (Pm x D\'b2) 
\par \par \pard Siendo: 
\par \pard \li567 Pa y Pb = Presiones absolutas en origen y extremo del conducto respectivamente,
 en Kg/cm\'b2 en (1) y en mmca en (2).
\par dc = Densidad corregida del gas.
\par L = Longitud equivalente de tuber\'eda o v\'e1lvula (m).
\par Q = Caudal simult\'e1neo o probable (m\'b3/h).
\par D = Di\'e1metro de tuber\'eda (mm).
\par v = Velocidad del gas (m/s).
\par Pm = Presi\'f3n absoluta media en el tramo (Kg/cm\'b2). (Pa + Pb) / 2.
\par \par \pard {\ul Coeficientes de simultaneidad}.
\par \par - Instalaciones individuales Viviendas:
\par \par \pard \li567 Q{\fs12 \dn6 S} = Q{\fs12 \dn6 1} + Q{\fs12 \dn6 2} + Q{\fs12 \dn6 3}/2 + ...... + Q{\fs12 \dn6 n}/2.
\par \par \pard - Instalaciones individuales Locales:
\par \par \pard \li567 Q{\fs12 \dn6 S} = Q{\fs12 \dn6 1} + Q{\fs12 \dn6 2} + Q{\fs12 \dn6 3} + ...... + Q{\fs12 \dn6 n}.
\par \par \pard Siendo: 
\par \pard \li567 Q{\fs12 \dn6 S} = Caudal simult\'e1neo o probable (m\'b3/h).
\par Q{\fs12 \dn6 1} , Q{\fs12 \dn6 2} = Caudales mayores alimentados por el tramo (m\'b3/h).
\par Q{\fs12 \dn6 3} , .... Q{\fs12 \dn6 n} = Resto de caudales alimentados por el tramo (m\'b3/h).
\par \par \pard - Instalaciones comunes:
\par \par \pard \li567 Q{\fs12 \dn6 S} = {\f1 S}{\fs12 \dn6 i} N x Q{\fs12 \dn6 SV} x S + {\f1 S}{\fs12 \dn6 i} N x Q{\fs12 \dn6 L}.
\par \par \pard Siendo: 
\par \pard \li567 Q{\fs12 \dn6 S} = Caudal simult\'e1neo o probable del conjunto de viviendas y locales (m\'b3/h).
\par Q{\fs12 \dn6 SV} = Caudal simult\'e1neo o probable de viviendas (m\'b3/h).
\par Q{\fs12 \dn6 L} = Caudal simult\'e1neo o probable de locales (m\'b3/h).
\par N = Nº de viviendas o locales del grupo considerado.
\par S = Coeficiente de simultaneidad por viviendas. Depende si en el grupo existe o no caldera de calefacci\'f3n.
\par \par \pard {\b \fs24 Datos Generales}
\par \par Tipo de gas : Gas natural.
\par \pard \li567 - Densidad relativa aire : 0,56.
\par - Densidad corregida : 0,62.
\par - PCS (MJ/m\'b3 (s)) : 40,68.
\par \pard Tipo de instalaci\'f3n : Edificio de viviendas.
\par Velocidad m\'e1xima (m/s) : 20.
\par P\'e9rdidas secundarias : 20%.
\par Presi\'f3n relativa min. aparato (mmca) : 180.
\par P\'e9rdidas de carga m\'e1ximas :
\par \pard \li567 
\par - Parte BP (P <= 500 mmca) : 25.
\par - Parte MP/AP (P > 500 mmca) : 500.
\par \pard
\par A continuaci\'f3n se presentan los resultados obtenidos para las distintas ramas y nudos:
