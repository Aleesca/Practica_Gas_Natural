% --- Configuración de los índices (TOC, LOF, LOT) ---
\tocloftpagestyle{empty} % Páginas sin numeración ni encabezados
\renewcommand{\cftsecpagefont}{\normalfont} % Evitar advertencias de Bold Small Caps

% Títulos: Negrita y 16pt (aprox. 2 puntos más que los 14.4pt de \Large)
\newcommand{\estiloTitulosIndices}{\fontsize{16pt}{19.2pt}\selectfont\bfseries}
\renewcommand{\cfttoctitlefont}{\estiloTitulosIndices}
\renewcommand{\cftloftitlefont}{\estiloTitulosIndices}
\renewcommand{\cftlottitlefont}{\estiloTitulosIndices}

% Espaciado tras los títulos
\setlength{\cftaftertoctitleskip}{1.5cm}
\setlength{\cftafterloftitleskip}{1.5cm}
\setlength{\cftafterlottitleskip}{1.5cm}

% Indentación de entradas
\cftsetindents{figure}{1.5em}{2.3em}
\cftsetindents{table}{1.5em}{2.3em}

% Quitar números de página en LOF y LOT
\cftpagenumbersoff{figure}
\cftpagenumbersoff{table}

\graphicspath{{Figuras/}}

% --- Colores y Cajas ---
\usepackage{tcolorbox}
