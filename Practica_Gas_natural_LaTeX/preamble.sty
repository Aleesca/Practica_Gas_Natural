% --- Configuración de Pies de Nota (números en azul) ---
\makeatletter
\renewcommand\@makefnmark{\hbox{\@textsuperscript{\normalfont\color{blue}\@thefnmark}}}
\makeatother

\definecolor{maincolor}{HTML}{005596}
\definecolor{accentcolor}{HTML}{2E86C1}
\definecolor{softgray}{HTML}{F5F7FA}

% --- Formato de secciones (cada \section en página nueva) ---
\titleformat{\section}[block]{\clearpage\color{black}\Large\bfseries}{\thesection}{0.8em}{}
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{2.3ex plus .2ex}
\titleformat{\subsection}{\color{black}\large\bfseries}{\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% --- Encabezado y pie de página ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyhead[R]{\small Página \textbf{\thepage}\ de \textbf{\pageref*{LastPage}}}
\fancyfoot[L]{\asignatura}

% Pagestyle para el contenido principal (con nombre de sección en centro)
\fancypagestyle{contenido}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
  \fancyhead[C]{\parbox{0.6\textwidth}{\centering\vspace{0.1cm}\small\nouppercase{\leftmark}\vspace{0.1cm}}}
  \fancyhead[R]{\small Página \textbf{\thepage}\ de \textbf{\pageref*{LastPage}}}
  \fancyfoot[L]{\asignatura}
}

% Redefinir sectionmark para mostrar solo el título sin el número
\makeatletter
\renewcommand{\sectionmark}[1]{%
  \markboth{#1}{}%
}
\makeatother

% --- Configuración de siunitx ---
\sisetup{
	locale = DE,
	per-mode = symbol,
	group-minimum-digits = 4,
	table-number-alignment = center
}

% --- Numeración de figuras y tablas por sección ---
\counterwithin{figure}{section}
\counterwithin{table}{section}

% --- Variables del documento ---
\newcommand{\titulo}{PRÁCTICA GAS NATURAL}
\newcommand{\asignatura}{Instalaciones II}

% --- Estilo de anexos ---
\newcounter{appendixcounter}
\renewcommand{\theappendixcounter}{\arabic{appendixcounter}}

\newcommand{\myappendix}[1]{%
	\cleardoublepage
	\thispagestyle{empty}
	\refstepcounter{appendixcounter}
	\vspace*{\fill}
	\begin{center}
		\parbox{0.9\textwidth}{\centering\Huge\bfseries Anexo \theappendixcounter. #1}
	\end{center}
	\vspace*{\fill}
	\addcontentsline{toc}{section}{Anexo \theappendixcounter: #1}
	\normalfont
	\cleardoublepage
}

